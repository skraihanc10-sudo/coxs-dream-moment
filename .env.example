# ============================================================
# Cox's Dream Moment — the settings the server reads.
#
# THIS FILE IS A TEMPLATE. It holds names, never values.
#
# The real values go into Coolify → your application →
# Environment Variables. They are stored encrypted there and handed to the
# container at start. They must never be written into a file in this
# repository: it is public, GitHub scans public repositories for secrets,
# and a leaked Gmail App Password means someone else reading your email.
#
# .env is in .gitignore for the same reason. If you keep a local copy for
# testing, keep it there and nowhere else.
# ============================================================


# ---------------------------------------------------------------- required

# Where the admin panel's own login password lives. This is the owner's
# password — there is only one, and it is not stored in any file.
ADMIN_PASSWORD=

# Signs the login cookies. Keep the SAME value you used on Railway, or every
# customer and every admin is signed out the moment you deploy.
# If you ever need a fresh one: openssl rand -hex 32
SESSION_SECRET=

# The writable directory. In Coolify this is the persistent volume, and
# without it every deploy wipes the uploaded photos and the bookings.
DATA_DIR=/data

NODE_ENV=production

# Used to build the links inside emails. Get this wrong and every
# "see your booking" button points at the wrong place.
SITE_URL=https://coxsdreammoment.shop


# ---------------------------------------------------------------- email
#
# Gmail, with an App Password — Google refuses the account password, and an
# App Password can be revoked on its own if it ever leaks.
#
# To make one: myaccount.google.com → Security → turn on 2-Step
# Verification → App passwords → create one, name it "Cox's Dream Moment".
# It looks like "abcd efgh ijkl mnop"; the spaces do not matter.
#
# Leave these blank and everything still works — nothing is emailed, and
# every customer shows up under Customers → "Waiting to be told" with a
# WhatsApp button instead.

GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=Cox's Dream Moment <your-address@gmail.com>


# ---------------------------------------------------------------- optional
#
# "Continue with Google" on the my-bookings page.
#
# console.cloud.google.com → APIs & Services → Credentials →
# Create credentials → OAuth client ID → Web application.
# Under "Authorized JavaScript origins" put:  https://coxsdreammoment.shop
#
# Leave it blank and the Google button simply does not appear. Signing in
# with a phone number still works.

GOOGLE_CLIENT_ID=


# ---------------------------------------------------------------- local only
#
# Not set in production. Coolify gives the container its own port.
# PORT=3000
