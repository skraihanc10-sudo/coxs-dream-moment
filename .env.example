# Copy this file to .env for local development, or set these as
# environment variables in Railway's dashboard (Variables tab) for
# production. Never commit a real .env file.

# Password for the /admin login. Required - the server refuses all
# logins until this is set.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin login cookie. Use a long random
# string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-too

# Where content/*.json and images/ are read from and written to.
# On Railway: attach a Volume (Settings -> Volumes) and set this to its
# mount path, e.g. /data - otherwise admin edits are lost on redeploy.
# Leave unset for local development (defaults to this project folder).
# DATA_DIR=/data

# Railway sets PORT automatically - only needed for local testing on a
# specific port.
# PORT=3000
